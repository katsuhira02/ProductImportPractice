## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
out/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.doccache
*.sublime-project
*.sublime-workspace

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# MonoDevelop writing
mono_crash.*

# VS Code
.vscode/

# Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet 4.x+ Code Analysis NuGet package
# !**/[Pp]ackages/Microsoft.CodeAnalysis.NetAnalyzers*

# Service Fabric
*.dotSettings.user

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
wwwroot/lib/

# Examples (Optional, but usually we don't want to ignore them if they are small)
# /examples_csv/products_export_*.csv

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
