@model IEnumerable<ProductImportPractice.Models.Product>
@{
    ViewData["Title"] = "Список товаров";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Список товаров</h1>
    <div class="d-flex gap-2">
        @if (Model.Any())
        {
            <a asp-action="Export" class="btn btn-outline-primary">Экспорт в CSV</a>
            <form asp-action="Clear" method="post" onsubmit="return confirm('Вы уверены, что хотите очистить весь список?');">
                <button type="submit" class="btn btn-outline-danger">Очистить список</button>
            </form>
        }
        <a asp-action="Import" class="btn btn-primary">Импортировать CSV</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">Все товары</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>SKU</th>
                        <th>Название</th>
                        <th>Категория</th>
                        <th class="text-end">Цена</th>
                        <th class="text-end">Остаток</th>
                        <th class="text-center">Активен</th>
                        <th class="text-center" style="width: 100px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Товары не найдены. Пожалуйста, выполните импорт.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.Sku</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" alt="@product.Name" class="me-2 rounded" style="width: 32px; height: 32px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/32'">
                                        }
                                        <div>
                                            <div class="fw-bold">@product.Name</div>
                                            <small class="text-muted d-block text-truncate" style="max-width: 200px;">@product.Description</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@product.CategoryName</td>
                                <td class="text-end">@product.Price.ToString("N2") @product.Currency</td>
                                <td class="text-end">@product.Stock</td>
                                <td class="text-center">
                                    <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                        @(product.IsActive ? "Да" : "Нет")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" title="Редактировать">
                                            &#9998;
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить" onclick="return confirm('Удалить этот товар?');">
                                                &times;
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
