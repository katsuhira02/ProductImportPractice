@model ProductImportPractice.Models.ImportResult
@{
    ViewData["Title"] = "Результаты импорта";
}

<div class="mb-4">
    <h1>Результаты импорта</h1>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-success h-100">
            <div class="card-body text-center">
                <h2 class="text-success display-4 mb-2">@Model.ImportedCount</h2>
                <p class="text-muted mb-0">Товаров успешно импортировано</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-danger h-100">
            <div class="card-body text-center">
                <h2 class="text-danger display-4 mb-2">@Model.Errors.Count</h2>
                <p class="text-muted mb-0">Ошибок при импорте</p>
            </div>
        </div>
    </div>
</div>

@if (Model.HasErrors)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0 text-danger">Список ошибок</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100px;">Строка</th>
                            <th>Сообщение об ошибке</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in Model.Errors)
                        {
                            <tr>
                                <td>@error.LineNumber</td>
                                <td>@error.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="d-flex gap-2">
    <a asp-action="Index" class="btn btn-primary">К списку товаров</a>
    <a asp-action="Import" class="btn btn-outline-secondary">Загрузить еще один файл</a>
</div>
